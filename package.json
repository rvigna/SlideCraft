{
  "name": "slidecraft",
  "version": "2.0.0",
  "private": true,
  "description": "A modern web-based presentation editor built with React, TypeScript and IBM Carbon",
  "author": {
    "name": "Rodrigo Vigna",
    "email": "rvigna@outlook.com"
  },
  "license": "MIT",
  "type": "module",
  "keywords": [
    "presentation",
    "slides",
    "editor",
    "react",
    "typescript",
    "carbon",
    "pptx"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:cli": "vite build --ssr src/cli/main.ts --outDir dist-cli --emptyOutDir --logLevel warn",
    "slidecraft": "npm run --silent build:cli && node dist-cli/main.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.1.0",
    "@carbon/icons-react": "^11.91.0",
    "@carbon/react": "^1.119.0",
    "immer": "^11.2.9",
    "jsdom": "^29.1.1",
    "jszip": "^3.10.2",
    "pptxgenjs": "^4.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "sass": "^1.106.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "bin": {
    "slidecraft": "bin/slidecraft.mjs"
  }
}
